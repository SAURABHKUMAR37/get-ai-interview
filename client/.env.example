# Copy this file to ".env" in the same folder (client/.env) and fill in your own values.
# Never commit the real .env file — it is already ignored by .gitignore.

# URL of the backend server (see server/.env.example)
VITE_SERVER_URL=http://localhost:6000

# Firebase (used for Google Sign-In). Get these from your Firebase project
# Console -> Project settings -> General -> Your apps -> Web app config.
# Only VITE_FIREBASE_API_KEY is required if you're reusing the original demo
# Firebase project; fill in the rest if you create your own project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay public key id (same value as RAZORPAY_KEY_ID on the server side)
VITE_RAZORPAY_KEY_ID=

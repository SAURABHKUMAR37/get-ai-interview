# Copy this file to ".env" in the same folder (server/.env) and fill in your own values.
# Never commit the real .env file — it is already ignored by .gitignore.

# ---- Server ----
PORT=6000

# ---- MongoDB ----
# Local MongoDB (if you have MongoDB installed / running via Compass locally):
# MONGODB_URL=mongodb://127.0.0.1:27017/getaiinterview
#
# MongoDB Atlas (cloud) — copy the connection string from Compass / Atlas
# ("Connect" -> "Drivers" or "Compass" -> paste the URI) and put your DB user
# password in it. Example shape:
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/getaiinterview?retryWrites=true&w=majority
MONGODB_URL=

# ---- Auth ----
# Any long random string, e.g. generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWTSECRET=

# ---- CORS ----
# Comma-separated list of frontend URLs allowed to call this API
CLIENT_URL=http://localhost:5173

# ---- OpenRouter (AI questions / feedback) ----
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- Razorpay (payments) ----
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Environment ----
NODE_ENV=development
